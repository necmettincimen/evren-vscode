{
  "name": "evren-vscode",
  "displayName": "Evren",
  "description": "EVREN CLI için sohbet paneli: akan yanıt, araç kartları, diff onayı, oturumlar.",
  "version": "0.1.0",
  "publisher": "necmettincimen",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/necmettincimen/evren-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/necmettincimen/evren-vscode/issues"
  },
  "homepage": "https://github.com/necmettincimen/evren-vscode#readme",
  "keywords": [
    "evren",
    "ai",
    "agent",
    "chat",
    "cli",
    "ndjson",
    "coding assistant",
    "türkçe"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "evren",
          "title": "Evren",
          "icon": "media/evren.svg"
        }
      ]
    },
    "views": {
      "evren": [
        {
          "type": "webview",
          "id": "evren.chat",
          "name": "Sohbet"
        },
        {
          "id": "evren.agents",
          "name": "Ajanlar",
          "icon": "media/evren.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "evren.openChat",
        "title": "Evren: Open Chat"
      },
      {
        "command": "evren.newSession",
        "title": "Evren: New Session"
      },
      {
        "command": "evren.addSelection",
        "title": "Evren: Add Selection to Chat"
      },
      {
        "command": "evren.cancel",
        "title": "Evren: Cancel"
      },
      {
        "command": "evren.showLogs",
        "title": "Evren: Show Logs"
      },
      {
        "command": "evren.restart",
        "title": "Evren: Restart CLI"
      },
      {
        "command": "evren.resumeSession",
        "title": "Evren: Resume Session"
      },
      {
        "command": "evren.selectModel",
        "title": "Evren: Select Model"
      },
      {
        "command": "evren.selectMode",
        "title": "Evren: Select Mode"
      },
      {
        "command": "evren.acceptChange",
        "title": "Evren: Accept Change",
        "icon": "$(check)"
      },
      {
        "command": "evren.rejectChange",
        "title": "Evren: Reject Change",
        "icon": "$(close)"
      },
      {
        "command": "evren.agents.refresh",
        "title": "Ajanları yenile",
        "category": "Evren",
        "icon": "$(refresh)"
      },
      {
        "command": "evren.agents.stop",
        "title": "Sonlandır",
        "category": "Evren",
        "icon": "$(debug-stop)"
      },
      {
        "command": "evren.agents.openLog",
        "title": "Günlüğü aç",
        "category": "Evren",
        "icon": "$(go-to-file)"
      },
      {
        "command": "evren.agents.copyPrompt",
        "title": "İstemi kopyala",
        "category": "Evren",
        "icon": "$(copy)"
      },
      {
        "command": "evren.agents.revealWorkspace",
        "title": "Çalışma dizinini göster",
        "category": "Evren",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "evren.acceptChange",
          "when": "evren.pendingDiff && isInDiffEditor",
          "group": "navigation@1"
        },
        {
          "command": "evren.rejectChange",
          "when": "evren.pendingDiff && isInDiffEditor",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "evren.newSession",
          "when": "view == evren.chat",
          "group": "navigation@1"
        },
        {
          "command": "evren.resumeSession",
          "when": "view == evren.chat",
          "group": "navigation@2"
        },
        {
          "command": "evren.agents.refresh",
          "when": "view == evren.agents",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "evren.agents.stop",
          "when": "view == evren.agents && viewItem == evrenProcess",
          "group": "inline@2"
        },
        {
          "command": "evren.agents.copyPrompt",
          "when": "view == evren.agents && viewItem =~ /^evrenProcess/",
          "group": "inline@1"
        },
        {
          "command": "evren.agents.revealWorkspace",
          "when": "view == evren.agents && viewItem =~ /^evrenProcess/",
          "group": "1_open@1"
        },
        {
          "command": "evren.agents.stop",
          "when": "view == evren.agents && viewItem == evrenProcess",
          "group": "9_stop@1"
        },
        {
          "command": "evren.agents.openLog",
          "when": "view == evren.agents && viewItem == evrenLog",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "evren.agents.stop",
          "when": "false"
        },
        {
          "command": "evren.agents.openLog",
          "when": "false"
        },
        {
          "command": "evren.agents.copyPrompt",
          "when": "false"
        },
        {
          "command": "evren.agents.revealWorkspace",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "evren.addSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Evren",
      "properties": {
        "evren.cliPath": {
          "type": "string",
          "default": "evren",
          "description": "evren çalıştırılabilir dosyası (PATH'te ad ya da tam yol)."
        },
        "evren.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Doluysa CLI `<python> -m src.cli --stdio` ile başlatılır (çalışma dizini evren.cliRepo)."
        },
        "evren.cliRepo": {
          "type": "string",
          "default": "",
          "description": "evren.pythonPath kullanılırken evren-cli kaynak dizini."
        },
        "evren.model": {
          "type": "string",
          "default": "",
          "description": "Başlangıç modeli (boşsa CLI varsayılanı)."
        },
        "evren.defaultMode": {
          "type": "string",
          "enum": [
            "normal",
            "plan",
            "ask"
          ],
          "default": "normal",
          "description": "Başlangıç kipi."
        },
        "evren.autoApprove": {
          "type": "string",
          "enum": [
            "none",
            "edits",
            "all"
          ],
          "default": "none",
          "description": "none: her şeyi sor; edits: dosya düzenlemelerini onaysız uygula; all: --yes."
        },
        "evren.allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Onaysız çalışacak araçlar (--allowed-tools)."
        },
        "evren.extraEnv": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "CLI sürecine eklenecek ortam değişkenleri. API anahtarı yazmayın."
        },
        "evren.autoAttachActiveFile": {
          "type": "boolean",
          "default": false,
          "description": "Her isteğe aktif dosyayı ek olarak koy."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && tsc -p ./webview",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package",
    "test:e2e": "npm run compile && node out/test/e2e/run.js",
    "test:compat": "npm run compile && node --test \"out/test/compat/*.compat.js\"",
    "coverage": "npm run compile && c8 --reporter=lcov --reporter=text-summary node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "typescript": "~5.9.3"
  }
}
